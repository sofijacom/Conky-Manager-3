-- Minimal · System Monitor
-- CPU, GPU, memory, temperatures, fans, disks and network in one tall widget
-- Part of the Minimal widget pack for Conky Manager 3. It sits where the right
-- column of the Minimal theme goes, so use it instead of that column.
-- Settings (12-hour clock, dark text, weather location/units) live at the top
-- of lua/minimal.lua.

local dir = debug.getinfo(1, 'S').source:match('^@(.*)/[^/]*$') or '.'

-- lua_load splits paths on spaces, so load the script through a space-free link
local lua_dir = dir .. '/lua'
if lua_dir:find('%s') then
	local link = (os.getenv('XDG_RUNTIME_DIR') or '/tmp') .. '/conky-minimal-lua'
	os.execute(string.format("ln -sfn '%s' '%s'", (lua_dir:gsub("'", "'\\''")), link))
	lua_dir = link
end

conky.config = {
	lua_load = lua_dir .. '/minimal.lua',
	-- the design size (420 x 780); the script scales the widget to fit the window,
	-- so changing the size below zooms it
	lua_draw_hook_pre = 'minimal_main monitor 420 780',

	alignment = 'top_right',
	gap_x = 24,
	gap_y = 20,
	minimum_width = 420,
	minimum_height = 780,

	update_interval = 2,
	double_buffer = true,
	background = false,
	use_xft = true,
	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	no_buffers = true,

	own_window = true,
	own_window_type = 'normal',
	own_window_class = 'Conky',
	own_window_title = 'Minimal System Monitor',
	own_window_transparent = true,
	own_window_argb_visual = true,
	own_window_argb_value = 0,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
}

