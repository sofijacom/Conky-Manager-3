-- Liquid Glass · Processes
-- Top 5 processes by CPU
-- Part of the Liquid Glass widget pack for Conky Manager 3.
-- Settings (12-hour clock, weather location/units, network interface) live at
-- the top of lua/widgets.lua; colors and glass strength in lua/glass.lua.

local dir = debug.getinfo(1, 'S').source:match('^@(.*)/[^/]*$') or '.'

-- lua_load splits paths on spaces, so load the scripts through a space-free link
local lua_dir = dir .. '/lua'
if lua_dir:find('%s') then
	local link = (os.getenv('XDG_RUNTIME_DIR') or '/tmp') .. '/conky-liquid-glass-lua'
	os.execute(string.format("ln -sfn '%s' '%s'", (lua_dir:gsub("'", "'\\''")), link))
	lua_dir = link
end

conky.config = {
	lua_load = lua_dir .. '/widgets.lua',
	-- the design size (360 x 264); the script scales the widget to fit the window,
	-- so changing the size below zooms it
	lua_draw_hook_pre = 'glass_main processes 360 264',

	alignment = 'top_left',
	gap_x = 24,
	gap_y = 248,
	minimum_width = 360,
	minimum_height = 264,

	update_interval = 2,
	double_buffer = true,
	background = false,
	use_xft = true,
	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	cpu_avg_samples = 2,
	net_avg_samples = 2,
	no_buffers = true,

	own_window = true,
	own_window_type = 'normal',
	own_window_class = 'Conky',
	own_window_title = 'Liquid Glass Processes',
	own_window_transparent = true,
	own_window_argb_visual = true,
	own_window_argb_value = 0,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
}

