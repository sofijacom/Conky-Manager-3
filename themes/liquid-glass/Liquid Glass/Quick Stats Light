-- Liquid Glass · Quick Stats Light
-- Light version of Quick Stats: white panel, dark text
-- Part of the Liquid Glass widget pack for Conky Manager 3.
-- Settings (12-hour clock, weather location/units, network interface) go in
-- settings.lua in this folder, which is kept when the pack is updated.

local dir = debug.getinfo(1, 'S').source:match('^@(.*)/[^/]*$') or '.'

-- lua_load splits paths on spaces, so load the scripts through a space-free link
local lua_dir = dir .. '/lua'
if lua_dir:find('%s') then
	local link = (os.getenv('XDG_RUNTIME_DIR') or '/tmp') .. '/conky-liquid-glass-lua'
	os.execute(string.format("ln -sfn '%s' '%s'", (lua_dir:gsub("'", "'\\''")), link))
	lua_dir = link
end

conky.config = {
	lua_load = lua_dir .. '/widgets.lua',
	-- the design size (240 x 204); the script scales the widget to fit the window,
	-- so changing the size below zooms it
	lua_draw_hook_pre = 'glass_main stats_light 240 204',

	alignment = 'bottom_right',
	gap_x = 24,
	gap_y = 24,
	minimum_width = 240,
	minimum_height = 204,

	update_interval = 2,
	double_buffer = true,
	background = false,
	use_xft = true,
	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	cpu_avg_samples = 2,
	net_avg_samples = 2,
	no_buffers = true,

	own_window = true,
	own_window_type = 'normal',
	own_window_class = 'Conky',
	own_window_title = 'Liquid Glass Quick Stats Light',
	own_window_transparent = true,
	own_window_argb_visual = true,
	own_window_argb_value = 0,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
}

